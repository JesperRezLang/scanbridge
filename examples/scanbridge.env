# Environment file for: docker run --env-file scanbridge.env ...
# One KEY=value per line. Quotes are not removed and a # after a value is part of the value, so keep comments on
# their own lines. See the README for every variable.

# Printer: address and the name shown under Scan -> to PC (1-15 ASCII characters, no " or ;).
SCANBRIDGE_PRINTER_HOST=192.0.2.20
SCANBRIDGE_DISPLAY_NAME=SCANBRIDGE

# LAN address of the Docker host, where the printer sends the button press (UDP 54925).
# Required unless the container runs with --network host.
SCANBRIDGE_ADVERTISE_IP=192.0.2.10

# Web interface login of the printer. These are the factory defaults; only needed if you changed them.
# SCANBRIDGE_PRINTER_USERNAME=Public
# SCANBRIDGE_PRINTER_PASSWORD=0000

# Seafile: URL of the server and a library API token (library -> Advanced -> API Token, read-write).
SCANBRIDGE_SEAFILE_URL=https://seafile.example.com
SCANBRIDGE_SEAFILE_TOKEN=replace-with-library-api-token
SCANBRIDGE_SEAFILE_DIRECTORY=/Scans

# Or save to a folder inside the container (mount it with -v /srv/scans:/scans).
# SCANBRIDGE_LOCAL_PATH=/scans

# File name without extension. Fields: {date:<strftime format>}, {target}, {function}, {printer}.
# SCANBRIDGE_FILENAME=Scan_{date:%Y-%m-%d_%H%M%S}

# Time zone for the dates in file names.
TZ=Europe/Stockholm

# SCANBRIDGE_LOG_LEVEL=INFO
